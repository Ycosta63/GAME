# Copy this file to .env.local for local testing, or set these as
# environment variables in your hosting provider's dashboard (e.g. Vercel).
# None of these are required for local development with `npm run dev` —
# without them the app stays open in single-user "local" mode.

# --- Google sign-in (each visitor gets their own private library) ---
# Create these at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# NEXTAUTH_SECRET=a-random-string-used-to-sign-session-cookies
# NEXTAUTH_URL=https://your-app.vercel.app

# --- Steam: one app-wide API key, so visitors never need their own ---
# Create at https://steamcommunity.com/dev/apikey (any domain name works,
# e.g. your Vercel domain). Visitors just click "Se connecter avec Steam"
# (OpenID) to link their own SteamID — this key is only used to read the
# public game data Steam's API exposes for whichever SteamID is linked.
# STEAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Persists each user's Steam/PSN credentials in a free Upstash Redis database ---
# Required on serverless hosts (Vercel) where the local filesystem isn't
# writable/persistent. Not needed on hosts with a real persistent disk
# (self-hosted, Render, your own PC) — a local data/settings-<user>.json is
# used instead when these are unset.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
