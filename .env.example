# Copy this file to .env.local for local testing, or set these as
# environment variables in your hosting provider's dashboard (e.g. Vercel).
# None of these are required for local development with `npm run dev`.

# --- Protects the whole site behind a password (strongly recommended once hosted) ---
# APP_PASSWORD=choose-a-strong-password
# AUTH_SECRET=a-second-random-string-used-to-sign-the-session-cookie

# --- Persists Steam/PSN credentials in a free Upstash Redis database ---
# Required on serverless hosts (Vercel) where the local filesystem isn't
# writable/persistent. Not needed on hosts with a real persistent disk
# (self-hosted, Render, your own PC) — a local data/settings.json is used
# instead when these are unset.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
